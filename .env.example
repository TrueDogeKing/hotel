# Skopiuj do .env i dostosuj wartości.

# --- PostgreSQL ---
POSTGRES_USER=campcenter
POSTGRES_PASSWORD=campcenter
POSTGRES_DB=campcenter
POSTGRES_PORT=5432

# --- JWT (token dostępu) ---
JWT__Issuer=CampCenter
JWT__Audience=CampCenter
JWT__Key=zmien-ten-klucz-na-dlugi-losowy-sekret-min-32-znaki
JWT__ExpiryMinutes=15

# --- Refresh token (token odświeżania, cookie HttpOnly) ---
RefreshToken__ExpiryDays=7
RefreshToken__CookieName=refreshToken
RefreshToken__CookieSecure=true
RefreshToken__CookieSameSite=Strict
RefreshToken__CookiePath=/api/auth

# --- E-mail (SMTP) ---
# Dev: Mailpit (docker) na localhost:1025, podgląd wiadomości na http://localhost:8025
Email__Host=localhost
Email__Port=1025
Email__From=rezerwacje@campcenter.local
Email__FromName=Ośrodek CampCenter
Email__UseSsl=false

# --- Produkcja (docker-compose.prod.yml) ---
# Twoja domena wskazująca na publiczne IP serwera.
#DOMAIN=osrodek.example.com
# Hasło pierwszego konta administratora (seed przy pierwszym starcie).
#ADMIN_PASSWORD=zmien-mnie-Silne1!

# --- Przelewy24 (płatności) ---
# Dane z panelu P24 (sandbox: https://sandbox.przelewy24.pl/panel).
#P24_MERCHANT_ID=00000
#P24_POS_ID=00000
#P24_CRC_KEY=xxxxxxxxxxxxxxxx
#P24_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Produkcja: https://secure.przelewy24.pl (domyślnie sandbox).
#P24_BASE_URL=https://sandbox.przelewy24.pl

# --- Produkcyjny SMTP (docker-compose.prod.yml; dev używa Mailpita) ---
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=rezerwacje@example.com
#EMAIL_PASSWORD=haslo
#EMAIL_FROM=rezerwacje@example.com
#EMAIL_USE_SSL=true
# Adres alarmowy (wpłata do anulowanej rezerwacji).
#BOOKING_ADMIN_ALERT_EMAIL=admin@example.com
