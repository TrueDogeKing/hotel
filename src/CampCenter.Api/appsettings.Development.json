{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RefreshToken": {
    "CookieSecure": false
  },
  "Database": {
    // Program.cs reads both flags, but no config file defined them, so a fresh dev
    // database had no schema, no admin user and no meal slots — and meal
    // generation silently does nothing without meal slots. Migrating and seeding
    // must both be on: seeding an unmigrated database fails at startup. Both are
    // idempotent. Integration tests override these to false and run the two steps
    // explicitly in CampCenterApiFactory.
    "MigrateAutomatically": true,
    "SeedAutomatically": true
  }
}
