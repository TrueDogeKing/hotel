{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=campcenter;Username=campcenter;Password=campcenter"
  },
  "Jwt": {
    "Issuer": "CampCenter",
    "Audience": "CampCenter",
    "Key": "dev-only-change-me-super-secret-jwt-signing-key-min-32-bytes",
    "ExpiryMinutes": 15
  },
  "RefreshToken": {
    "ExpiryDays": 7,
    "CookieName": "refreshToken",
    "CookieSecure": true,
    "CookieSameSite": "Strict",
    "CookiePath": "/api/auth"
  },
  "Admin": {
    "Login": "admin",
    "Password": "Admin123!"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 30
    }
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "From": "rezerwacje@campcenter.local",
    "FromName": "Ośrodek CampCenter",
    "UseSsl": false
  }
}
