# Reverse proxy behind a Cloudflare Tunnel: Cloudflare's edge already terminates
# TLS for visitors, and with no port forwarded in, Caddy could never complete its
# own Let's Encrypt HTTP-01 challenge anyway — so this listens on plain HTTP and
# leaves certificates to Cloudflare. cloudflared talks to this over the Docker
# network, not the public internet.
#
# Moving to a host with a real public IP (a VPS) instead of a tunnel? Swap the
# `:80 { ... }` block below back to `{$DOMAIN} { ... }` (see git history) to let
# Caddy obtain its own certificate again.
:80 {
	encode zstd gzip

	# Baseline security headers on every response, API included (the SPA container
	# adds its own CSP for HTML). `header` replaces rather than appends, so an
	# upstream copy is not duplicated.
	header {
		# Visitors always reach this through Cloudflare's HTTPS edge, so telling
		# browsers to refuse plain HTTP for a year costs nothing. No `preload`:
		# that is a one-way listing and should be a deliberate decision.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# REST API.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else: the SPA served by nginx.
	handle {
		reverse_proxy frontend:8080
	}
}
