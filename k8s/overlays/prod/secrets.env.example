# Copy to secrets.env (gitignored) and fill in real values:
#   cp k8s/overlays/prod/secrets.env.example k8s/overlays/prod/secrets.env
#
# These are the same values docker-compose.prod.yml takes from .env. Kustomize
# turns this file into a Secret; nothing here is encrypted at rest in etcd by
# default, so on a shared cluster reach for Sealed Secrets, SOPS or an external
# secret store instead of committing a filled-in copy.
POSTGRES_PASSWORD=change-me
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=campcenter;Username=campcenter;Password=change-me
# Min. 32 characters, random.
Jwt__Key=change-me-to-a-long-random-secret-min-32-chars
# First admin account, created by the seeder on first start.
Admin__Password=change-me-Strong1!
Email__Username=rezerwacje@example.com
Email__Password=change-me
