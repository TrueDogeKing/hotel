# Development secrets — deliberately checked in, deliberately worthless.
# Everything here is the same throwaway value the dev compose stack uses; the
# prod overlay reads its own gitignored secrets.env instead.
POSTGRES_PASSWORD=campcenter
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=campcenter;Username=campcenter;Password=campcenter
Jwt__Key=dev-only-key-not-a-secret-min-32-characters-long
Admin__Password=Admin123!
